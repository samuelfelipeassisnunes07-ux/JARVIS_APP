{
  "expo": {
    "name": "jarvis-app",
    "slug": "jarvis-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Jarvislogo_1.png",
    "scheme": "jarvisapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lipe_6767.jarvisapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Jarvislogo_1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1851f7a-8433-48b1-adea-4768f51d2fea"
      }
    }
  }
}
